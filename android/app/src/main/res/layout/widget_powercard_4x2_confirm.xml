<?xml version="1.0" encoding="utf-8"?>
<!-- 标准 4×2 确认态：第一次点击开机/关机后显示，第二次点击确认才发送指令 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/widget_confirm_off_title"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_confirm_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_confirm_hint"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_confirm_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_cancel"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.85"
            android:background="@drawable/widget_btn_neutral"
            android:gravity="center"
            android:text="@string/widget_btn_cancel"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_confirm_on"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_btn_green"
            android:gravity="center"
            android:text="@string/widget_btn_confirm_on"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_confirm_off"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="@drawable/widget_btn_red"
            android:gravity="center"
            android:text="@string/widget_btn_confirm_off"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
