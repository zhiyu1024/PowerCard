<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      网络权限说明：
      设备状态 / 开关机 / 重启请求全部由 Java 原生 HttpURLConnection 在手机网络中直接发出，
      WebView 只加载本地 assets，不访问任何远程网页，因此只需要 INTERNET 权限。
      ACCESS_NETWORK_STATE 仅用于网络可用性判断，可选。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PowerCard"
        android:usesCleartextTraffic="true">

        <!--
          明文流量说明：开机卡/路由器提供的接口多为局域网 http:// 地址，targetSdk 35 默认禁止明文，
          这里显式允许（usesCleartextTraffic=true）；设备 URL 由用户在设置中填写，仅本机保存。
          配置写入 SharedPreferences 前经 Android Keystore AES/GCM 加密，allowBackup=false 避免进云备份。
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          桌面小组件（v1.1.0）：RemoteViews 实现，不依赖 WorkManager/Compose/Glance。
          exported=false：只接收系统 APPWIDGET_UPDATE 与本 App 内部的显式广播/闹钟。
          无需新增任何危险权限；不注册 RECEIVE_BOOT_COMPLETED（重启后由系统在下次
          APPWIDGET_UPDATE / 打开 App / 手动刷新时恢复，避免申请开机广播权限）。
        -->
        <receiver
            android:name=".PowerCardWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.powercard.remote.widget.REFRESH_ALL" />
                <action android:name="com.powercard.remote.widget.WIDGET_REFRESH" />
                <action android:name="com.powercard.remote.widget.POWER_ON" />
                <action android:name="com.powercard.remote.widget.POWER_OFF" />
                <action android:name="com.powercard.remote.widget.CONFIRM" />
                <action android:name="com.powercard.remote.widget.CANCEL" />
                <action android:name="com.powercard.remote.widget.DELAYED_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>

</manifest>
